// Onion Skin installer: drag this file into Maya's viewport.
// It installs (or updates) Onion Skin from the "onion_skin" folder next to this file, adds the Onion shelf
// button and opens the window.

global proc onionSkinInstallerLocator() {}

{
    string $where = `whatIs "onionSkinInstallerLocator"`;
    string $file = `substitute "Mel procedure found in: " $where ""`;
    string $dir = dirname($file);
    $dir = substituteAllString($dir, "\\", "/");
    python("import importlib.util as _os_u");
    python("_os_s = _os_u.spec_from_file_location('onion_skin_install', r'" + $dir + "/onion_skin/install.py')");
    python("_os_m = _os_u.module_from_spec(_os_s); _os_s.loader.exec_module(_os_m)");
    python("_os_m.install(r'" + $dir + "')");
}
